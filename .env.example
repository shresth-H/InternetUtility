# ==========================================
# ToolBox Production & Local Environment Config
# ==========================================

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 Object Storage (Leave blank for Local Storage Adapter)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=toolbox-files
R2_CUSTOM_DOMAIN=

# Limits & Quotas (V1 Security Guardrails)
MAX_FILE_SIZE_BYTES=26214400 # 25 MB
MAX_PDF_PAGES=100
MAX_IMAGE_PIXELS=25000000 # 25 Megapixels
JOB_TIMEOUT_SECONDS=60
MAX_RETRIES=3
JOB_RETENTION_MINUTES=60

# AI Provider (Optional)
GEMINI_API_KEY=

